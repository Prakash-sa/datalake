{
  "name": "rag-query-frontend",
  "version": "1.0.0",
  "description": "Production desktop and web UI for the Document RAG Engine",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next typegen && tsc --noEmit --incremental false",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "backend:dist": "node scripts/package-backend.js",
    "dist:electron": "electron-builder",
    "dist": "npm run build && npm run backend:dist && npm run dist:electron",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "next": "^16.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  }
}
