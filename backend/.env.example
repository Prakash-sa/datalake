# RAG Engine Development Environment Configuration
# Copy this to .env and customize for your environment

# ========== ENVIRONMENT ==========
# Options: development, testing, production
ENV=development
LOG_LEVEL=DEBUG

# ========== SERVER ==========
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ========== CORS ==========
# For development: use "*" to allow all origins
# For production: specify exact origins
ALLOWED_ORIGINS=*

# ========== RAG ENGINE ==========
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=all-minilm
LLM_MODEL=mistral
LLM_TEMPERATURE=0.5

# ========== RESOURCE LIMITS ==========
MAX_DOCUMENTS=10000
MAX_QUERY_LENGTH=1000
MAX_RESULTS=100
QUERY_TIMEOUT=30

# ========== PERFORMANCE ==========
EMBEDDING_CACHE_SIZE=128
CORS_CACHE_MAX_AGE=3600

# ========== MONITORING ==========
ENABLE_METRICS=true
METRICS_PORT=9090

# ========== MINIO (Optional - for document storage) ==========
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# ========== DEBUG ==========
# Only for development - never enable in production
DEBUG=true
