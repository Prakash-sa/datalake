# Backend configuration. Copy to `.env` and adjust.
# Every key below is read by src/rag_backend/settings.py.

# --- Environment -------------------------------------------------------------
# Profile supplying defaults: development | testing | production.
# Anything you set explicitly below overrides the profile default.
ENV=production
LOG_LEVEL=INFO
DEBUG=false

# --- HTTP server -------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
WORKERS=4

# Require `Authorization: Bearer <token>` on every request.
# The Electron shell generates this per launch; leave unset for local container use.
# RAG_API_TOKEN=

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:3000
CORS_CACHE_MAX_AGE=600

# --- Embeddings --------------------------------------------------------------
# "local" runs all-MiniLM-L6-v2 in-process via ONNX and needs no external
# software. "ollama" delegates to the daemon, for a larger model.
# Switching invalidates the index and forces a rebuild.
EMBEDDING_PROVIDER=local
# Defaults to the model bundled beside the package.
# LOCAL_EMBEDDING_MODEL_DIR=

# --- Generation --------------------------------------------------------------
# "local" runs a GGUF model through llama.cpp and does not require
# Ollama. "ollama" delegates written answers to the daemon.
GENERATION_PROVIDER=local
# Defaults to the model bundled beside the package.
# LOCAL_LLM_MODEL_PATH=
# Number of model layers to offload to Apple Metal/GPU. Use 0 for CPU-only.
LOCAL_LLM_GPU_LAYERS=12
# Caps answer length to keep local generation responsive.
LOCAL_LLM_MAX_TOKENS=256
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_TEMPERATURE=0.1

# --- Logging -----------------------------------------------------------------
# Defaults to $APP_DATA_DIR/logs. Rotates by size, bounding disk use at
# LOG_MAX_BYTES * (LOG_BACKUP_COUNT + 1).
# LOG_DIR=
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
# Strips filesystem paths and credentials from log output. Left on in
# production; the development profile disables it, since full paths are what
# make an error actionable locally.
LOG_REDACT=true

# --- Local storage -----------------------------------------------------------
CHROMA_PATH=./chroma_db
APP_DATA_DIR=.
# Defaults to $APP_DATA_DIR/app.db when unset.
# APP_DB_PATH=

# --- Resource limits ---------------------------------------------------------
MAX_DOCUMENTS=10000
MAX_QUERY_LENGTH=1000
MAX_RESULTS=100
QUERY_TIMEOUT=30
