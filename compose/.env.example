# Environment for the Airflow ingestion pipeline. Copy to `compose/.env`.
#
# Docker Compose reads `.env` from the project directory, which is the directory
# of the first `-f` file, so this belongs beside the compose files.
#
# The desktop application uses none of this; its settings live in
# backend/.env.example.

# --- Published ports ---------------------------------------------------------
OLLAMA_PORT=11434
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
CHROMA_PORT=8001
AIRFLOW_PORT=9093

# --- MinIO -------------------------------------------------------------------
# CHANGE THESE before exposing the stack beyond localhost.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION=us-east-1

# --- Airflow -----------------------------------------------------------------
# Match this to your host UID on Linux (`id -u`) to avoid root-owned log files.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
