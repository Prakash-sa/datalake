# Compose environment. Copy to `compose/.env` and adjust.
#
# Docker Compose reads `.env` from the project directory, which is the directory
# of the first `-f` file — so this file must live beside the compose files, not
# at the repository root.
#
# Every variable below is interpolated by a file in this directory. Backend
# process configuration lives in backend/.env.example.

# --- Published ports ---------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
OLLAMA_PORT=11434
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
CHROMA_PORT=8001
AIRFLOW_PORT=9093

# --- Models ------------------------------------------------------------------
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=orca-mini
LLM_TEMPERATURE=0.1
# Production overlay only.
OLLAMA_NUM_THREAD=8

# --- Backend -----------------------------------------------------------------
LOG_LEVEL=INFO
WORKERS=4
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ----------------------------------------------------------------
# Resolved by the browser, so use a host-reachable address.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- MinIO -------------------------------------------------------------------
# CHANGE THESE before exposing the stack beyond localhost.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION=us-east-1

# --- Airflow (compose.airflow.yml) -------------------------------------------
# Match this to your host UID on Linux (`id -u`) to avoid root-owned log files.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Production resource limits (compose.prod.yml) ---------------------------
CPU_LIMIT=2
MEMORY_LIMIT=4G
CPU_RESERVE=1
MEMORY_RESERVE=2G
